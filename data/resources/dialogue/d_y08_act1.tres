"option2_ko": "",
"option2_next": "",
"effect": ""
}, {
"node": "4",
"speaker": "y08_ongi",
"text_ko": "네 비밀도 하나 담아 줄까. …아니, 아직 이르다.",
"portrait": "y08_ongi",
"next": "end",
