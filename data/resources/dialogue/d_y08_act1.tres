"option2_ko": "",
"option2_next": "",
"effect": ""
}, {
"node": "3",
"speaker": "y08_ongi",
"text_ko": "뭐든. 김치도 소문도 비밀도. 항아리는 담으라고 있는 거니까.",
"portrait": "y08_ongi",
"next": "4",
